{
  "rules": {
    "greaterEqual": {"result": {"op": "greaterEqual", "right": {"op": "evaluate", "field": "right"}, "left": {"op": "evaluate", "field": "left"}}},
    "greater": {"result": {"op": "greater", "right": {"op": "evaluate", "field": "right"}, "left": {"op": "evaluate", "field": "left"}}},
    "lessEqual": {"result": {"op": "lessEqual", "right": {"op": "evaluate", "field": "right"}, "left": {"op": "evaluate", "field": "left"}}},
    "less": {"result": {"op": "less", "right": {"op": "evaluate", "field": "right"}, "left": {"op": "evaluate", "field": "left"}}},
    "stringType": {"result": {"op": "stringType"}},
    "string": {"result": {"field": "value", "op": "text"}},
    "true": {"result": {"value": true, "op": "boolean"}},
    "boolType": {"result": {"op": "bool"}},
    "false": {"result": {"value": false, "op": "boolean"}},
    "notEqual": {"result": {"op": "notEqual", "right": {"op": "evaluate", "field": "right"}, "left": {"op": "evaluate", "field": "left"}}},
    "equal": {"result": {"op": "equal", "right": {"op": "evaluate", "field": "right"}, "left": {"op": "evaluate", "field": "left"}}},
    "divide": {"result": {"op": "divide", "right": {"op": "evaluate", "field": "right"}, "left": {"op": "evaluate", "field": "left"}}},
    "modulo": {"result": {"op": "modulo", "right": {"op": "evaluate", "field": "right"}, "left": {"op": "evaluate", "field": "left"}}},
    "quotient": {"result": {"op": "quotient", "right": {"op": "evaluate", "field": "right"}, "left": {"op": "evaluate", "field": "left"}}},
    "remainder": {"result": {"op": "remainder", "right": {"op": "evaluate", "field": "right"}, "left": {"op": "evaluate", "field": "left"}}},
    "negate": {"result": {"op": "negate", "value": {"op": "evaluate", "field": "operand"}}},
    "subtract": {
      "result": {
        "op": "difference",
        "right": {"op": "evaluate", "field": "right"},
        "left": {"op": "evaluate", "field": "left"}
      }
    },
    "upperBound": {"result": {"op": "upperBound", "value": {"op": "field", "field": "value"}}},
    "lowerBound": {"result": {"op": "lowerBound", "value": {"op": "field", "field": "value"}}},
    "intType": {"result": {"op": "int"}},
    "unify": {
      "result": {
        "op": "unify",
        "right": {"op": "evaluate", "field": "right"},
        "left": {"op": "evaluate", "field": "left"}
      }
    },
    "multiply": {
      "result": {
        "op": "product",
        "right": {"op": "evaluate", "field": "right"},
        "left": {"op": "evaluate", "field": "left"}
      }
    },
    "integer": {"result": {"op": "field", "field": "value"}},
    "add": {
      "result": {
        "op": "sum",
        "right": {"op": "evaluate", "field": "right"},
        "left": {"op": "evaluate", "field": "left"}
      }
    }
  },
  "formatVersion": 1
}
