package bootstrap

// The backend's recursion, branches and parser-frame call layout live here.
#PrattLowering: #LoweringPolicy & {
	let L = {op: "lower", field: "left"}
	let R = {op: "lower", field: "right"}
	let Calls = {
		primary:        "primary", afterOperand:            "after_operand", afterWordOperator: "after_word_operator"
		lookupOperator: "lookup_operator", advanceOperator: "advance_operator"
		parseRight:     "parse_right", buildBinary:         "build_binary", whitespace:  "whitespace"
		scanGroup:      "scan_group", advanceGroup:         "advance_group", closeGroup: "close_group"
		scanBound:      "scan_bound", advanceBound:         "advance_bound", parseBound: "parse_bound"
		scanIdentifier: "scan_identifier", parseAtom:       "parse_atom", parseInteger:  "parse_integer"
		scanString:     "scan_string", parseString:         "parse_string"
		scanNot:        "scan_not", advanceNot:             "advance_not", buildNot:           "build_not"
		scanNegation:   "scan_negation", advanceNegation:   "advance_negation", buildNegation: "build_negation"
	}
	cases: {
		for name, method in Calls {
			"\(name)": {op: "text", value: "_frame.step()?;\n_frame.\(method)()?;\n"}
		}
		program: {op: "concat", parts: [
			{op: "text", value: "// Generated by bootstrap-pratt-codegen. Do not edit by hand.\nuse crate::parser::{Error, Frame};\npub fn execute(_frame: &mut Frame<'_, '_>) -> Result<(), Error> {\n"},
			{op: "list", field: "body"}, {op: "text", value: "Ok(())\n}\n"},
		]}
		minimum: {op: "text", value: "_frame.minimum()"}
		tokenLength: {op: "text", value: "_frame.token_length()?"}
		precedence: {op: "text", value: "_frame.precedence()?"}
		integer: {op: "concat", parts: [{op: "unsigned", field: "value"}, {op: "text", value: "u8"}]}
		add: *{op: "concat", parts: [{op: "text", value: "_frame.binding_add("}, L,
			{op: "text", value: ", "}, R, {op: "text", value: ")?"}]} | {op: "lower", field: "left"}
		hasOperator: {op: "text", value: "_frame.has_operator()"}
		leftAssociative: {op: "text", value: "_frame.left_associative()?"}
		groupOpen: {op: "text", value: "_frame.group_open()?"}
		hasBound: {op: "text", value: "_frame.has_bound()?"}
		hasIdentifier: {op: "text", value: "_frame.has_identifier()?"}
		hasString: {op: "text", value: "_frame.has_string()?"}
		hasNegation: {op: "text", value: "_frame.has_negation()?"}
		hasNot: {op: "text", value: "_frame.has_not()?"}
		boolean: {op: "boolean", field: "value"}
		atLeast: {op: "concat", parts: [L, {op: "text", value: " >= "}, R]}
		and: {op: "concat", parts: [L, {op: "text", value: " && "}, R]}
		setBindingPower: {op: "concat", parts: [{op: "text", value: "_frame.step()?;\n_frame.set_binding_power("},
			{op: "lower", field: "value"}, {op: "text", value: ")?;\n"}]}
		parseGroup: {op: "concat", parts: [{op: "text", value: "_frame.step()?;\n_frame.parse_group("},
			{op: "lower", field: "minimum"}, {op: "text", value: ")?;\n"}]}
		parseNot: {op: "concat", parts: [{op: "text", value: "_frame.step()?;\n_frame.parse_not("},
			{op: "lower", field: "minimum"}, {op: "text", value: ")?;\n"}]}
		parseNegation: {op: "concat", parts: [{op: "text", value: "_frame.step()?;\n_frame.parse_negation("},
			{op: "lower", field: "minimum"}, {op: "text", value: ")?;\n"}]}
		while: {op: "concat", parts: [{op: "text", value: "while { _frame.step()?; "},
			{op: "lower", field: "condition"}, {op: "text", value: " } {\n"},
			{op: "list", field: "body"}, {op: "text", value: "}\n"}]}
		"if": {op: "concat", parts: [{op: "text", value: "_frame.step()?;\nif "},
			{op: "lower", field: "condition"}, {op: "text", value: " {\n"}, {op: "list", field: "then"}, {
				op: "ifEmpty", field: "else"
				then: {op: "text", value: ""}
				else: {op: "concat", parts: [{op: "text", value: "} else {\n"}, {op: "list", field: "else"}]}
			}, {op: "text", value: "}\n"}]}
	}
}
