package bootstrap

#ScanLowering: #LoweringPolicy & {
	let Step = {op: "text", value: "cursor.step()?;\n"}
	let Then = {op: "get", name: "then"}
	let Else = {op: "get", name: "else"}
	let Empty = {op: "text", value: ""}
	let Not = {op: "ifTrue", field: "inverse", then: {op: "text", value: "!"}, else: Empty}
	cases: {
		program: {op: "concat", parts: [
			{op: "text", value: "// Generated by bootstrap-scan-codegen. Do not edit by hand.\nuse crate::scanner::{Cursor, Error, Scan};\npub fn scan(source: &str, offset: usize) -> Result<Scan, Error> {\nlet "},
			{op: "ifEmpty", field: "body", then: {op: "text", value: "cursor"}, else: {op: "text", value: "mut cursor"}},
			{op: "text", value: " = Cursor::new(source, offset)?;\n"}, {op: "list", field: "body"},
			{op: "text", value: "Ok(cursor.finish())\n}\n"},
		]}
		while: {op: "ifTrue", field: "once", then: {op: "concat", parts: [
			Step, {op: "text", value: "if "}, {op: "lower", field: "condition"}, {op: "text", value: " {\n'scan"},
			{op: "unsigned", field: "depth"}, {op: "text", value: ": {\n"}, {op: "list", field: "body"}, {op: "text", value: "}\n}\n"},
		]}, else: {op: "concat", parts: [
			{op: "text", value: "while { cursor.step()?; "}, {op: "lower", field: "condition"},
			{op: "text", value: " } {\n"}, {op: "list", field: "body"}, {op: "text", value: "}\n"},
		]}}
		"if": {op: "bind", name: "then", value: {op: "list", field: "then"}, body: {
			op: "bind", name: "else", value: {op: "list", field: "else"}, body: {op: "concat", parts: [Step, {
				op: "ifEqual", left: Then, right: Else, then: Then, else: {
					op: "ifEqual", left: Then, right: Empty, then: {op: "concat", parts: [
						{op: "text", value: "if "}, {op: "lower", field: "inverted"}, {op: "text", value: " {\n"}, Else, {op: "text", value: "}\n"},
					]}, else: {op: "concat", parts: [
						{op: "text", value: "if "}, {op: "lower", field: "condition"}, {op: "text", value: " {\n"}, Then,
						{op: "ifEqual", left: Else, right: Empty, then: Empty, else: {op: "concat", parts: [{op: "text", value: "} else {\n"}, Else]}},
						{op: "text", value: "}\n"},
					]}
				}
			}]}
		}}
		advance: {op: "text", value: *"cursor.step()?;\ncursor.advance()?;\n" | string}
		advanceChar: {op: "text", value: "cursor.step()?;\ncursor.advance_char()?;\n"}
		break: {op: "concat", parts: [Step, {op: "ifTrue", field: "labeled", then: {op: "concat", parts: [
			{op: "text", value: "break 'scan"}, {op: "unsigned", field: "label"}, {op: "text", value: ";\n"},
		]}, else: {op: "text", value: "break;\n"}}]}
		setFlag: {op: "concat", parts: [Step, {op: "text", value: "cursor.set_flag("}, {op: "boolean", field: "value"}, {op: "text", value: ");\n"}]}
		reject: {op: "concat", parts: [Step, {op: "text", value: "cursor.reject("}, {op: "string", field: "reason"}, {op: "text", value: ")?;\n"}]}
		and: {op: "concat", parts: [
			{op: "text", value: "("}, {op: "lower", field: "left"},
			{op: "ifTrue", field: "inverse", then: {op: "text", value: ") || ("}, else: {op: "text", value: ") && ("}},
			{op: "lower", field: "right"}, {op: "text", value: ")"},
		]}
		or: {op: "concat", parts: [
			{op: "text", value: "("}, {op: "lower", field: "left"},
			{op: "ifTrue", field: "inverse", then: {op: "text", value: ") && ("}, else: {op: "text", value: ") || ("}},
			{op: "lower", field: "right"}, {op: "text", value: ")"},
		]}
		byteIn: {op: "concat", parts: [Not, {op: "text", value: "matches!("}, {
			op: "ifZero", field: "ahead", then: {op: "text", value: "cursor.peek()"}, else: {op: "concat", parts: [
				{op: "text", value: "cursor.peek_at("}, {op: "unsigned", field: "ahead"}, {op: "text", value: ")"},
			]}
		}, {op: "text", value: ", Some("}, {op: "bytePattern", field: "bytes"}, {op: "text", value: "))"}]}
