package bootstrap

#AstLowering: #LoweringPolicy & {
	let Copy = {op: "concat", parts: [{op: "text", value: "_arg"}, {op: "unsigned", field: "index"}]}
	let Owned = {op: "concat", parts: [{op: "text", value: "_arg"}, {op: "unsigned", field: "index"}, {
		op: "ifZero", field: "remaining", then: {op: "text", value: ""}, else: {op: "text", value: ".clone()"}
	}]}
	cases: {
		program: {op: "concat", parts: [
			{op: "text", value: "// Generated by bootstrap-ast-codegen. Do not edit by hand.\nuse serde_json::Value;\npub fn build("},
			{op: "join", field: "parameters", separator: ", "}, {op: "text", value: ") -> Value {\n"},
			{op: "lower", field: "result"}, {op: "text", value: "\n}\n"},
		]}
		parameter: {op: "concat", parts: [{op: "text", value: "_arg"}, {op: "unsigned", field: "index"}, {op: "text", value: ": "}, {
			op: "select", field: "type", cases: {
				string: {op: "text", value: "String"}, integer: {op: "text", value: "i64"}, json: {op: "text", value: "Value"}
			}
		}]}
		argument: {op: "select", field: "type", cases: {
			integer: {op: "concat", parts: [{op: "text", value: "Value::from("}, Copy, {op: "text", value: ")"}]}
			json: Owned
			string: {op: "select", field: "role", cases: {
				key: Owned
				value: {op: "concat", parts: [{op: "text", value: "Value::String("}, Owned, {op: "text", value: ")"}]}
			}}
		}}
		string: {op: "select", field: "role", cases: {
			key: {op: "concat", parts: [{op: "text", value: "String::from("}, {op: "string", field: "value"}, {op: "text", value: ")"}]}
			value: {op: "concat", parts: [{op: "text", value: "Value::String(String::from("}, {op: "string", field: "value"}, {op: "text", value: "))"}]}
		}}
		integer: _
		object: {op: "ifEmpty", field: "fields", then: {op: "text", value: "Value::Object(serde_json::Map::new())"}, else: {
			op: "concat", parts: [{op: "text", value: "Value::Object(serde_json::Map::from_iter(["},
				{op: "join", field: "fields", separator: ",\n"}, {op: "text", value: "]))"}]
		}}
		field: {op: "concat", parts: [{op: "text", value: "("}, {op: "lower", field: "key"},
			{op: "text", value: ", "}, {op: "lower", field: "value"}, {op: "text", value: ")"}]}
	}
}
